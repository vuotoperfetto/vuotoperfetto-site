heroes:
  - id: goffrato
    title: Goffrato
    subtitle: "Sacchetti sottovuoto goffrati a rombo"
    button: "Visita la pagina dei sacchetti goffrati"
    url: /goffrato/
    desktop: /materiale/img/VuotoPerfetto-sacchetti-buste-sottovuoto-goffrate-rombo-105micron-alimenti-1920x1080.avif
    mobile: /materiale/img/VuotoPerfetto-sacchetti-buste-sottovuoto-goffrate-rombo-105micron-alimenti-800x1200.avif
    alt: "Sacchetti e buste sottovuoto goffrate a rombo da 105 micron per alimenti"
  - id: liscio
    title: Liscio
    subtitle: "Buste sottovuoto lisce per macchine a campana"
    button: "Visita la pagina delle buste lisce"
    url: /liscio/
    desktop: /materiale/img/VuotoPerfetto-sacchetti-buste-sottovuoto-lisce-90-micron-alimenti-1920x1080.avif
    mobile: /materiale/img/VuotoPerfetto-sacchetti-buste-sottovuoto-lisce-90-micron-alimenti-800x1200.avif
    alt: "Buste sottovuoto lisce da 90 micron per alimenti"
  - id: qualita
    title: Qualità
    subtitle: "Materiali certificati per uso alimentare"
    button: "Visita la pagina qualità"
    url: /qualita/
    desktop: /materiale/img/VuotoPerfetto-sacchetti-buste-sottovuoto-qualita-1920x1080.avif
    mobile: /materiale/img/VuotoPerfetto-sacchetti-buste-sottovuoto-qualita-800x1200.avif
    alt: "Qualità dei materiali per sacchetti e buste sottovuoto alimentari"
  - id: certificazioni
    title: Certificazioni
    subtitle: "Conformità e controllo qualità"
    button: "Visita la pagina certificazioni"
    url: /certificazioni/
    desktop: /materiale/img/VuotoPerfetto-sacchetti-buste-sottovuoto-certificazioni-caratteristiche-prodotti-1920x1080.avif
    mobile: /materiale/img/VuotoPerfetto-sacchetti-buste-sottovuoto-certificazioni-caratteristiche-prodotti-800x1200.avif
