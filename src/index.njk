---

{% for hero in heroes %}
<section class="hero-fullbleed" id="hero-{{ hero.id }}">
  <picture>
    <source media="(max-width: 768px)" srcset="{{ hero.mobile }}" type="image/avif">
    <img src="{{ hero.desktop }}" alt="{{ hero.alt }}" width="1920" height="1080"
         {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
  </picture>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-content">
    <h2 class="hero-title">
      <a href="{{ hero.url }}">{{ hero.title }}</a>
    </h2>
    <p class="hero-subtitle">{{ hero.subtitle }}</p>
    <a href="{{ hero.url }}" class="hero-cta">{{ hero.button }}</a>
  </div>
</section>
{% endfor %}
